---
pagination:
  data: collections.categoryList
  size: 1
  alias: category

permalink: "/category/{{ category | slug }}/"
---

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ category }} | Joydeep Tech</title>

    <link rel="stylesheet" href="/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

</head>


<body>


<!-- ================= HEADER ================= -->

<header class="header">

    <a href="/" class="logo">

        <img src="/Joydeeptech.png"
             alt="JoydeepTech">

    </a>


    <nav class="navbar">

        <ul>

            <li>
                <a href="/">Home</a>
            </li>

            <li>
                <a href="/search.html">Articles</a>
            </li>

            <li>
                <a href="#">About</a>
            </li>

            <li>
                <a href="#">Contact</a>
            </li>

        </ul>

    </nav>


    <div class="header-actions">

        <button id="theme-toggle"
                class="theme-btn">

            <i class="fa-solid fa-moon"></i>

        </button>


        <a href="/search.html"
           class="search-btn">

            <i class="fa-solid fa-magnifying-glass"></i>

        </a>


        <button class="menu-toggle">

            <i class="fa-solid fa-bars"></i>

        </button>

    </div>

</header>



<!-- ================= CATEGORY HERO ================= -->

<section class="hero">

    <div class="hero-content">

        <span class="hero-tag">
            📚 Joydeep Tech
        </span>


        <h1>

            {{ category }}

        </h1>


        <p>

            Explore all tutorials and articles
            from the {{ category }} category.

        </p>

    </div>

</section>



<!-- ================= CATEGORY ARTICLES ================= -->

<main>

<section class="trending">


    <div class="section-header">

        <div>

            <h2>
                📚 {{ category }} Tutorials
            </h2>

            <p>
                Learn {{ category }} with easy-to-follow tutorials.
            </p>

        </div>


        <a href="/search.html"
           class="view-all">

            All Articles →

        </a>

    </div>



    <div class="trending-grid">


        {# Get articles belonging to this category #}

        {% set categoryArticles =
            collections.articles | filterByCategory(category)
        %}


        {% for article in categoryArticles | reverse %}


        <article class="trend-card">


            <div class="trend-image">


                {% if article.data.image %}

                <img src="{{ article.data.image }}"
                     alt="{{ article.data.title }}">

                {% endif %}


                <span class="trend-badge">

                    📚 {{ category }}

                </span>


            </div>



            <div class="trend-content">


                <span class="category">

                    {{ article.data.category }}

                </span>


                <h3>

                    {{ article.data.title }}

                </h3>


                <p>

                    {{ article.data.description }}

                </p>



                <div class="trend-footer">

                    <span>

                        📅

                        {{ article.data.date | date("MMMM dd, yyyy") }}

                    </span>

                </div>



                <a href="{{ article.url }}">

                    Read Article →

                </a>


            </div>


        </article>


        {% else %}


        <div class="no-articles">

            <h3>
                No tutorials found.
            </h3>

            <p>
                There are currently no articles in this category.
            </p>

            <a href="/">
                ← Back to Home
            </a>

        </div>


        {% endfor %}


    </div>


</section>

</main>



<!-- ================= FOOTER ================= -->

<footer class="footer">


    <div class="footer-container">


        <div class="footer-box">


            <img src="/Joydeeptech.png"
                 alt="Joydeep Tech"
                 class="footer-logo">


            <p>

                Learn Computers & Technology with easy
                tutorials, programming guides, MS Office,
                Arduino, Photoshop, and many more.

            </p>

        </div>



        <div class="footer-box">

            <h3>
                Quick Links
            </h3>


            <ul>

                <li>
                    <a href="/">
                        Home
                    </a>
                </li>

                <li>
                    <a href="/search.html">
                        Articles
                    </a>
                </li>

                <li>
                    <a href="#">
                        About
                    </a>
                </li>

                <li>
                    <a href="#">
                        Contact
                    </a>
                </li>

            </ul>

        </div>



        <div class="footer-box">

            <h3>
                Categories
            </h3>


            <ul>

                <li>
                    <a href="/category/computer-fundamental/">
                        Computer Fundamental
                    </a>
                </li>

                <li>
                    <a href="/category/programming/">
                        Programming
                    </a>
                </li>

                <li>
                    <a href="/category/ms-office/">
                        MS Office
                    </a>
                </li>

                <li>
                    <a href="/category/web-development/">
                        Web Development
                    </a>
                </li>

                <li>
                    <a href="/category/graphics-design/">
                        Graphics Design
                    </a>
                </li>

                <li>
                    <a href="/category/arduino/">
                        Arduino
                    </a>
                </li>

                <li>
                    <a href="/category/ai-tools/">
                        AI Tools
                    </a>
                </li>

            </ul>

        </div>



        <div class="footer-box">

            <h3>
                Legal
            </h3>


            <ul>

                <li>
                    <a href="#">
                        Privacy Policy
                    </a>
                </li>

                <li>
                    <a href="#">
                        Terms & Conditions
                    </a>
                </li>

                <li>
                    <a href="#">
                        Disclaimer
                    </a>
                </li>

            </ul>

        </div>



        <div class="footer-box">

            <h3>
                Follow Us
            </h3>


            <div class="social-icons">


                <a href="https://www.facebook.com/joydeep.mukherjee.165/"
                   target="_blank">

                    <i class="fab fa-facebook-f"></i>

                </a>


                <a href="https://www.instagram.com/dilsejoydeep"
                   target="_blank">

                    <i class="fab fa-instagram"></i>

                </a>


            </div>

        </div>


    </div>



    <div class="footer-bottom">


        <p>

            © 2026 Joydeep Tech. All Rights Reserved.

        </p>


        <p class="designer-credit">

            Designed & Developed with ❤️ by

            <span>
                Joydeep Mukherjee
            </span>

        </p>


    </div>


</footer>



<script src="/script.js"></script>


</body>

</html>
