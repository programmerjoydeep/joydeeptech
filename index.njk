        </ul>

    </nav>


    <div class="header-actions">

        <button id="theme-toggle"
                class="theme-btn">

            <i class="fa-solid fa-moon"></i>

        </button>


        <a href="/search.html"
           class="search-btn">

            <i class="fa-solid fa-magnifying-glass"></i>

        </a>


        <button class="menu-toggle">

            <i class="fa-solid fa-bars"></i>

        </button>

    </div>

</header>



<!-- ================= HERO ================= -->

<section class="hero">

    <div class="hero-content">

        <span class="hero-tag">
            🚀 Learn • Build • Grow
        </span>


        <h1>

            Learn Computers &

            <span>
                Technology
            </span>

        </h1>


        <p>

            বাংলা ভাষায় কম্পিউটার, প্রোগ্রামিং,
            প্রযুক্তি, টিউটোরিয়াল ও ক্যারিয়ার গাইড।

        </p>


        <div class="hero-buttons">

            <a href="/search.html"
               class="btn-primary">

                Explore Articles

            </a>


            <a href="#featured-categories"
               class="btn-secondary">

                Explore Categories

            </a>

        </div>

    </div>

</section>



<!-- ================= TRENDING ARTICLES ================= -->

<main>

<section class="trending">


    <div class="section-header">

        <div>

            <h2>
                🔥 Trending Tutorials
            </h2>

            <p>
                Latest tutorials and technology articles.
            </p>

        </div>


        <a href="/search.html"
           class="view-all">

            View All →

        </a>

    </div>



    <div class="trending-grid">


        {# Get latest articles #}

        {% set articles = collections.articles | reverse %}


        {% for article in articles.slice(0, 6) %}


        <article class="trend-card">


            <div class="trend-image">


                {% if article.data.image %}

                <img src="{{ article.data.image }}"
                     alt="{{ article.data.title }}">

                {% endif %}


                <span class="trend-badge">

                    🔥 Trending

                </span>


            </div>



            <div class="trend-content">


                <span class="category">

                    {{ article.data.category }}

                </span>


                <h3>

                    {{ article.data.title }}

                </h3>


                <p>

                    {{ article.data.description }}

                </p>



                <div class="trend-footer">


                    <span>

                        📅

                        {{ article.data.date | date("MMMM dd, yyyy") }}

                    </span>


                </div>



                <a href="{{ article.url }}">

                    Read Article →

                </a>


            </div>


        </article>


        {% else %}


        <p>
            No articles published yet.
        </p>


        {% endfor %}


    </div>


</section>

</main>



